# Required
GROQ_API_KEY=

# Optional -- model override (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=

# Optional -- only needed if AllRecipes is blocking/timing out requests
# from your server's IP. Get these from your Webshare dashboard's proxy
# list (each proxy has its own IP:port, there's no shared gateway on the
# free plan).
WEBSHARE_USER=
WEBSHARE_PASS=
PROXY_SERVER=http://SOME_IP:SOME_PORT
